{
  "name": "vigueur-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server giving reliable access to French law from the official sources (Légifrance, Judilibre).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Vigueur contributors",
  "homepage": "https://github.com/me-no-code/vigueur-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/me-no-code/vigueur-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/me-no-code/vigueur-mcp/issues"
  },
  "keywords": [
    "legifrance",
    "judilibre",
    "french-law",
    "droit",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "vigueur-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "precoverage": "npm run build",
    "coverage": "vitest run --coverage",
    "pretest:live": "npm run build",
    "test:live": "vitest run test/live --mode live",
    "bundle": "node scripts/bundle.mjs",
    "test:bundle": "vitest run test/bundle/ --mode bundle",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector@2.16.0 node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "^2.6.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
