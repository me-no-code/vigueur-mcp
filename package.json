{
  "name": "vigueur-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server giving Claude reliable access to French law (Légifrance, Judilibre).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "vigueur-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:live": "VIGUEUR_LIVE=1 vitest run test/live",
    "bundle": "node scripts/bundle.mjs",
    "test:bundle": "VIGUEUR_BUNDLE=1 vitest run test/bundle/",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "^2.6.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
